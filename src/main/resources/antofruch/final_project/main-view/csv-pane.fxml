<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="antofruch.final_project.Contollers.MainView.CsvPaneController">
   <children>
      <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="189.0" spacing="60.0" AnchorPane.topAnchor="0.0">
         <children>
            <Button fx:id="importButton" mnemonicParsing="false" onAction="#handleImport" text="Import CSV" />
            <Button fx:id="exportButton" mnemonicParsing="false" onAction="#handleExport" text="Export to CSV" />
         </children>
         <padding>
            <Insets top="30.0" />
         </padding></VBox>
   </children>
</AnchorPane>
