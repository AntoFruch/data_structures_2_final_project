<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextField?>


<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="antofruch.final_project.Contollers.MainView.GeneratePaneController">
   <children>
      <Label layoutX="19.0" layoutY="31.0" text="Number of Points : " />
      <TextField fx:id="generateInputField" layoutX="133.0" layoutY="27.0" prefHeight="25.0" prefWidth="52.0" />
      <Button fx:id="generateButton" layoutX="48.0" layoutY="90.0" mnemonicParsing="false" onAction="#handleGenerate" prefHeight="32.0" prefWidth="95.0" text="Generate" />
      <Label fx:id="errorLabel" layoutX="64.0" layoutY="57.0" text="Incorrect entry" textAlignment="CENTER" textFill="RED">
         <font>
            <Font size="10.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
